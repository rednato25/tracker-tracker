# .dockerignore

# Dependencies (rebuilt in container)
node_modules

# Build output (rebuilt in container)
.next
out
build

# Git
.git
.gitignore

# Environment files (secrets, passed via docker-compose)
.env
.env.*

# IDE / editor
.vscode
.idea
.history
*.swp
*.swo
.DS_Store

# Documentation and plans (CHANGELOG.md is needed by /api/changelog)
docs
*.md
!CHANGELOG.md
!package.json

# Tests (not needed in production image)
**/*.test.ts
**/*.test.tsx
**/__tests__
coverage
vitest.config.*

# CI / tooling config
.github
.claude
.serena
.interface-design
.biomeignore
biome.json

# Development scripts.
#
# Runtime and operator scripts must reach the build context: the migration
# runner, its shared validators, the recovery CLI and the buffer backfill.
# Exclude development-only tools by name instead of excluding scripts/* and
# relying on negations; BuildKit cannot reliably re-include a child of an
# excluded directory.
scripts/knip-filter.sh
scripts/regen-changelog.cjs
scripts/security-audit-lib.ts
scripts/security-audit.ts
scripts/validate-trackers.ts

# Legacy Drizzle output is not used by the reviewed migration mechanism.
drizzle
